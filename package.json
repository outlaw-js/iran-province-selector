{
  "name": "iran-province-selector",
  "version": "1.0.0",
  "description": "Interactive map of Iran's provinces for React and Next.js: tooltips with auto-flip, custom colors, click handlers and multi-select.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsup --watch",
    "demo": "node example/serve.mjs",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/outlaw-js/iran-province-selector.git"
  },
  "homepage": "https://github.com/outlaw-js/iran-province-selector#readme",
  "keywords": [
    "iran",
    "map",
    "provinces",
    "svg",
    "react",
    "nextjs",
    "tooltip"
  ],
  "author": "",
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
